# ---- Frontend (safe to expose: these ship in the browser bundle) ----
# Leave both empty to run in LOCAL DEMO MODE (data stays in this browser, NOT secure).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server only (Supabase Edge Function secrets — NEVER prefix with VITE_) ----
# Set with: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically
#  inside hosted Edge Functions; list them here only for local `supabase functions serve`.)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
